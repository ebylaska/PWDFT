AtomContext atom_ctx;
atom_ctx.oprint           = oprint;
atom_ctx.tag              = tag;
atom_ctx.max_steps        = 25;
atom_ctx.minimum_gradient = 1.0e-3;
atom_ctx.initial_step     = 0.1;
atom_ctx.use_symmetry     = true;
atom_ctx.ops              = symmetry_info.ops;

const int ierr_atom = atom_minimizer(comm_world0, rtdbstring, coutput,
                                     minimizer, atom_ctx);
if (ierr_atom != 0)
{
    coutput << tag << "atom minimizer returned " << ierr_atom << '\n';
    return ierr_atom;
}
