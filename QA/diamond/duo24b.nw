title "swnc: e theory=pspw xc=pbe formula=Mg2F4 charge=0 mult=1"
#machinejob:expert
 
echo
permanent_dir ./perm20
scratch_dir   ./perm20

start pspw-pbe-mgf2
 
memory heap 950 mb stack 900 mb global 10 mb
 
charge 0


geometry noautoz nocenter noautosym
   system crystal
      lat_a  4.649
      lat_b  4.649
      lat_c  3.398
      alpha 90.0
      beta  90.0
      gamma 90.0
   end

Mg  0.000000  0.000000  0.000000
F   0.303     0.303     0.000

symmetry P42/mnm conventional
end


#symmetry P42/mnm setting 1 conventional

nwpw
  #simulation_cell
  #   ngrid 40 40 30 
  #end
  ### pseudopotential block begin ###
  ### pseudopotential block end   ###
  cutoff 50.0
  mult 1
  xc pbe
  lmbfgs grassman
  2d-hcurve
  includestress
  tolerances 1.0e-11 1.0e-11
  ewald_ncut 8
  ewald_rcut 3.0
end
task pspw energy
 
 
### restart here ###
driver
   clear
   #lattice_only
   geometry_lattice_alternating
   lattice_maxiter 25
end

task pspw relax


 
