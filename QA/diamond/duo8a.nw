title "diamond unit cell optimization"

echo

start C1a

memory 1900 mb

permanent_dir ./perm8a
scratch_dir   ./perm8a

charge 0

geometry noautoz nocenter noautosym 
   system crystal
      lat_a  3.546
      lat_b  3.546
      lat_c  3.546
      alpha 90.0000
      beta  90.0000
      gamma 90.0000
   end

#  C -0.51000d0 -0.52000d0 -0.50000d0  
#  C  0.00000d0  0.00000d0 -0.53000d0  
#  C  0.00000d0 -0.50000d0  0.00000d0  
#  C -0.50000d0  0.00000d0  0.00000d0  
#  C -0.25000d0 -0.25000d0 -0.25000d0  
#  C  0.25000d0  0.25000d0 -0.24000d0  
#  C  0.25000d0 -0.25000d0  0.25000d0  
#  C -0.25000d0  0.23000d0  0.25000d0  

C     0.00000    0.000000    0.000000
symmetry Fd-3m conventional
end

nwpw
  cutoff 50.0
  mult 1
  xc pbe96
  lmbfgs grassman
  ewald_ncut 8
  ewald_rcut 3.0
end
task pspw energy

#set nwpw:cif_filename  C1
set nwpw:kbpp_ray    .true.
set nwpw:kbpp_filter .true.
set includestress  .true.
set includelattice .true.
set nwpw:frozen_lattice:thresh 999.0
#set nwpw:zero_forces .true.

task pspw stress

#driver
#   clear
#   maxiter 500
#end
#task pspw optimize ignore

#set nwpw:zero_forces .false.
#task pspw optimize ignore

